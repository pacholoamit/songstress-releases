# Generated by `songstress install` — Discovery (AudioMuse-AI) overlay.
# Songstress analyses your music's sound itself; this keeps AudioMuse running
# beside it, for comparing their picks, until a later release retires it.
# AudioMuse reads the library through Songstress's OpenSubsonic API, signed in
# as the admin the installer seeded (MEDIASERVER_TYPE=navidrome and NAVIDROME_*
# are the names AudioMuse gives that client and its settings). AudioMuse is
# AGPL-3.0 and runs unmodified from upstream images
# (https://github.com/NeptuneHub/AudioMuse-AI). Internal-only: Songstress is
# the management surface.
services:
  songstress:
    depends_on:
      audiomuse:
        condition: service_started

  audiomuse:
    image: {{ .Pins.audiomuse }}
    container_name: songstress-audiomuse
    environment:
      - SERVICE_TYPE=flask
      - TZ=${TZ}
      - POSTGRES_USER=audiomuse
      - POSTGRES_PASSWORD=${AUDIOMUSE_DB_PASSWORD}
      - POSTGRES_DB=audiomusedb
      - POSTGRES_HOST=audiomuse-postgres
      - POSTGRES_PORT=5432
      - REDIS_URL=redis://audiomuse-redis:6379/0
      # Headless config (live-verified): MEDIASERVER_TYPE is REQUIRED or its
      # client settings are silently ignored; AUDIOMUSE_USER/PASSWORD create
      # its admin — without one every API call 403s with "Setup required".
      # Songstress shares gluetun's network with the VPN on.
      - MEDIASERVER_TYPE=navidrome
      - NAVIDROME_URL=http://{{ if .VPN }}gluetun{{ else }}songstress{{ end }}:8090
      - NAVIDROME_USER=${SONGSTRESS_ADMIN_EMAIL}
      - NAVIDROME_PASSWORD=${SONGSTRESS_ADMIN_PASSWORD}
      - AUTH_ENABLED=true
      - AUDIOMUSE_USER=admin
      - AUDIOMUSE_PASSWORD=${AUDIOMUSE_PASSWORD}
      - API_TOKEN=${AUDIOMUSE_API_TOKEN}
    depends_on:
      - audiomuse-postgres
      - audiomuse-redis
    restart: unless-stopped

  audiomuse-worker:
    image: {{ .Pins.audiomuse }}
    container_name: songstress-audiomuse-worker
    environment:
      - SERVICE_TYPE=worker
      - TZ=${TZ}
      - POSTGRES_USER=audiomuse
      - POSTGRES_PASSWORD=${AUDIOMUSE_DB_PASSWORD}
      - POSTGRES_DB=audiomusedb
      - POSTGRES_HOST=audiomuse-postgres
      - POSTGRES_PORT=5432
      - REDIS_URL=redis://audiomuse-redis:6379/0
      - MEDIASERVER_TYPE=navidrome
      - NAVIDROME_URL=http://{{ if .VPN }}gluetun{{ else }}songstress{{ end }}:8090
      - NAVIDROME_USER=${SONGSTRESS_ADMIN_EMAIL}
      - NAVIDROME_PASSWORD=${SONGSTRESS_ADMIN_PASSWORD}
      - AUDIOMUSE_USER=admin
      - AUDIOMUSE_PASSWORD=${AUDIOMUSE_PASSWORD}
      - API_TOKEN=${AUDIOMUSE_API_TOKEN}
    depends_on:
      - audiomuse-postgres
      - audiomuse-redis
    restart: unless-stopped

  audiomuse-postgres:
    image: {{ .Pins.postgres }}
    container_name: songstress-audiomuse-postgres
    environment:
      - TZ=${TZ}
      - POSTGRES_USER=audiomuse
      - POSTGRES_PASSWORD=${AUDIOMUSE_DB_PASSWORD}
      - POSTGRES_DB=audiomusedb
    volumes:
      - audiomuse-pgdata:/var/lib/postgresql/data
    restart: unless-stopped

  audiomuse-redis:
    image: {{ .Pins.redis }}
    container_name: songstress-audiomuse-redis
    volumes:
      - audiomuse-redisdata:/data
    restart: unless-stopped

volumes:
  audiomuse-pgdata:
  audiomuse-redisdata:
