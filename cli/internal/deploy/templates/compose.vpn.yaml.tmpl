# Generated by `songstress install` — VPN egress overlay. The songstress
# service joins gluetun's network namespace (wired in compose.yaml), so all
# acquisition egress rides the tunnel; LAN_SUBNET and the compose network stay
# outside it, so your devices and the other services still reach Songstress.
services:
  gluetun:
    image: {{ .Pins.gluetun }}
    container_name: songstress-gluetun
    cap_add:
      - NET_ADMIN
    devices:
      - /dev/net/tun:/dev/net/tun
    ports:
      # Published here because songstress shares this network namespace.
      - "${SONGSTRESS_PORT}:8090"
      # Jam voice. gluetun sends its answers out directly over TCP to
      # everyone, and over UDP only to the addresses in LAN_SUBNET; other UDP
      # answers go into the tunnel (README, Jam voice behind the VPN).
      - "${VOICE_PORT:-8093}:${VOICE_PORT:-8093}/udp"
      - "${VOICE_PORT:-8093}:${VOICE_PORT:-8093}/tcp"
    volumes:
      - ./gluetun:/gluetun
    environment:
      - VPN_SERVICE_PROVIDER=${VPN_SERVICE_PROVIDER}
      - VPN_TYPE=wireguard
      - WIREGUARD_PRIVATE_KEY=${WIREGUARD_PRIVATE_KEY}
      - WIREGUARD_ADDRESSES=${WIREGUARD_ADDRESSES}
      # Keep the UI and Jam voice reachable (TCP and UDP) and let LAN/Docker
      # traffic bypass the tunnel.
      - FIREWALL_INPUT_PORTS=8090,${VOICE_PORT:-8093}
      - FIREWALL_OUTBOUND_SUBNETS=${LAN_SUBNET}
      # Keep Docker DNS so compose service names resolve from this netns.
      - DNS_KEEP_NAMESERVER=on
      - TZ=${TZ}
    restart: unless-stopped
    # Rotated like compose.yaml's services (YAML anchors don't cross files).
    logging:
      driver: json-file
      options:
        max-size: "50m"
        max-file: "10"
    # A WireGuard tunnel idles at tens of MB; the ceiling only stops a runaway.
    mem_limit: ${GLUETUN_MEM_LIMIT:-256m}
    cpus: ${GLUETUN_CPUS:-0}
