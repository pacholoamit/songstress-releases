# Generated by `songstress install` — secrets live HERE and only here
# (mode 0600). songstress.lock.json carries no secrets. Re-running the
# installer keeps every password and key below.

# ── basics ───────────────────────────────────────────────────────────────────
TZ={{ q .TZ }}
PUID={{ .PUID }}
PGID={{ .PGID }}
MUSIC_DIR={{ q .MusicDir }}
SONGSTRESS_PORT={{ .Port }}
ENABLE_TELEMETRY={{ if .Telemetry }}true{{ else }}false{{ end }}

# ── app admin (sign-in for web, desktop & mobile) ────────────────────────────
{{- if .SkipAdminSeed }}
# admin is created in-app on first client connect
SONGSTRESS_ADMIN_EMAIL=
SONGSTRESS_ADMIN_PASSWORD=
{{- else }}
SONGSTRESS_ADMIN_EMAIL={{ q .AdminEmail }}
SONGSTRESS_ADMIN_PASSWORD={{ q .S.AdminPassword }}
{{- end }}

# ── public URL (set this if you front Songstress with a proxy/tunnel) ────────
# The origin you serve Songstress on, e.g. https://music.example.com. Makes
# invite & password-reset email links resolve; blank is fine on a LAN.
SONGSTRESS_PUBLIC_URL={{ q .PublicURL }}
{{- if .SMTPHost }}

# ── email / SMTP (invites, password resets & notifications) ──────────────────
SMTP_HOST={{ q .SMTPHost }}
SMTP_PORT={{ .SMTPPort }}
SMTP_USERNAME={{ q .SMTPUsername }}
SMTP_PASSWORD={{ q .S.SMTPPassword }}
SMTP_FROM={{ q .SMTPFrom }}
SMTP_TO={{ q .SMTPTo }}
SMTP_STARTTLS={{ if .SMTPStartTLS }}true{{ else }}false{{ end }}
{{- end }}
{{- if .ManagedNavidrome }}

# ── Navidrome (managed sibling service) ──────────────────────────────────────
# Navidrome creates its 'admin' with this password on its FIRST boot only, so
# it must never change while data/navidrome exists.
{{- if .Legacy }}
NAVIDROME_PORT={{ q (or (index .Keep "NAVIDROME_PORT") "4533") }}
{{- end }}
NAVIDROME_PASSWORD={{ q .S.NavidromePassword }}
{{- else }}

# ── Navidrome (your existing server) ─────────────────────────────────────────
# As the songstress container reaches it; the account must be a Navidrome admin.
NAVIDROME_URL={{ q .NavidromeURL }}
NAVIDROME_USERNAME={{ q .NavidromeUsername }}
NAVIDROME_PASSWORD={{ q .S.NavidromePassword }}
{{- if .Legacy }}
# Where your devices reach Navidrome (this release redirects streams there).
NAVIDROME_PUBLIC_URL={{ q .NavidromePublicURL }}
{{- end }}
{{- end }}
{{- if .Discovery }}

# ── Discovery (AudioMuse-AI side-car) ────────────────────────────────────────
AUDIOMUSE_API_TOKEN={{ q .S.AudioMuseToken }}
AUDIOMUSE_PASSWORD={{ q .S.AudioMusePassword }}
AUDIOMUSE_DB_PASSWORD={{ q .S.AudioMuseDB }}
{{- end }}
{{- if .VPN }}

# ── VPN egress (gluetun) ─────────────────────────────────────────────────────
VPN_SERVICE_PROVIDER={{ q (or (index .Keep "VPN_SERVICE_PROVIDER") "protonvpn") }}
WIREGUARD_PRIVATE_KEY={{ q .S.WGPrivateKey }}
WIREGUARD_ADDRESSES={{ q (or (index .Keep "WIREGUARD_ADDRESSES") "10.2.0.2/32") }}
LAN_SUBNET={{ q (or (index .Keep "LAN_SUBNET") "172.16.0.0/12") }}
{{- end }}
{{- if or .S.Extra (not .Legacy) }}

# ── your settings ────────────────────────────────────────────────────────────
{{- if .Legacy }}
# Added by hand; a re-run writes them back unchanged.
{{- else }}
# Add any of the README's "Settings" below (LOG_LEVEL, SONGSTRESS_MEM_LIMIT,
# SPOTIFY_CLIENT_ID, …); a re-run writes them back unchanged.
{{- end }}
{{- range $key, $value := .S.Extra }}
{{ $key }}={{ q $value }}
{{- end }}
{{- end }}
